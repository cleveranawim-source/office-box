  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default action: paper fill, 1.5px ink border.",
      "html": "<button class=\"ds-btn\">시수 보기 <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;border-radius:6px;padding:8px 14px;font:700 14px/1.5 'Pretendard Variable',Pretendard,sans-serif;border:1.5px solid #1a1d1a;background:#fff;color:#1a1d1a;cursor:pointer;transition:background .15s cubic-bezier(.16,1,.3,1),transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:#f2f4ee}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid #2563c9;outline-offset:2px}"
