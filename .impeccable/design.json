      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;border-radius:6px;padding:8px 14px;font:700 14px/1.5 'Pretendard Variable',Pretendard,sans-serif;border:1.5px solid #1a1d1a;background:#1a1d1a;color:#fff;cursor:pointer;transition:background .15s cubic-bezier(.16,1,.3,1),transform .15s}.ds-btn-primary:hover{background:#2e332e}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid #2563c9;outline-offset:2px}"
