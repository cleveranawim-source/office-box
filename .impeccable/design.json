      "html": "<input class=\"ds-input\" placeholder=\"구글시트 링크 붙여넣기\">",
      "css": ".ds-input{border:1.5px solid #d6d9d0;border-radius:6px;background:#fff;padding:7px 10px;min-height:36px;font:14px/1.5 'Pretendard Variable',Pretendard,sans-serif;color:#1a1d1a;transition:border-color .15s}.ds-input:hover{border-color:#b9beb2}.ds-input:focus{border-color:#1a1d1a;outline:none;box-shadow:0 0 0 3px rgb(37 99 201 / .18)}.ds-input::placeholder{color:#7d877f}"
